<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenLasso</AssemblyName>
    <RootNamespace>OpenLasso</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/OpenLasso.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>OpenLasso</Product>
    <Description>开源进程优化器 — 兼容 Process Lasso 核心功能</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets/OpenLasso.ico" LogicalName="OpenLasso.AppIcon.ico" />
  </ItemGroup>
</Project>
